rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_images/{conversationId}/{senderId}/{fileName} {
      function isConversationParticipant() {
        return request.auth != null
          && firestore.get(
            /databases/(default)/documents/conversations/$(conversationId)
          ).data.participantIds.hasAny([request.auth.uid]);
      }

      allow read: if isConversationParticipant();
      allow create: if isConversationParticipant()
        && request.auth.uid == senderId
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
